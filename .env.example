# Provider selection is explicit. Use mock only when you intentionally want offline fixtures.
LLM_PROVIDER=deepseek
SEARCH_PROVIDER=tavily

# Required when LLM_PROVIDER is openai or deepseek.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

LLM_THINKING_MODE=disabled
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS_STRUCTURED=2048
LLM_MAX_TOKENS_REPORT=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Required when SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=

# Optional runtime configuration
EVIDENCEPILOT_DB=data/evidencepilot.db
EVIDENCEPILOT_LOG_LEVEL=INFO
